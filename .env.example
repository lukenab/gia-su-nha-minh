MONGODB_URI=mongodb://127.0.0.1:27017/gia_su_nha_minh

# Admin sign-in
# Random string, at least 32 characters (e.g. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET=
# Only these emails can sign in (email/password), comma-separated.
ADMIN_ALLOWED_EMAILS=
# Public URL used for password reset email links (no trailing slash).
APP_URL=http://localhost:3000

# Google sign-in is disabled for the MVP.

# Password reset emails through Resend. Without these, `npm run dev` prints
# the link in the terminal and production cannot send reset emails.
RESEND_API_KEY=
EMAIL_FROM="Gia Sư Nhà Mình <no-reply@your-domain>"


# Accounts are provisioned with npm run admin:create (interactive prompts).
# ADMIN_BOOTSTRAP_EMAIL / ADMIN_BOOTSTRAP_NAME / ADMIN_BOOTSTRAP_PASSWORD
# may be supplied temporarily for noninteractive provisioning; never commit them.
