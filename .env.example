MONGODB_URI=mongodb://127.0.0.1:27017/gia_su_nha_minh

# Admin sign-in
# Random string, at least 32 characters (e.g. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET=
# Only these emails can sign in (Google or password), comma-separated.
ADMIN_ALLOWED_EMAILS=
# Public URL used for Google redirects and email links (no trailing slash).
APP_URL=http://localhost:3000

# Sign in with Google (Google Cloud Console → Credentials → OAuth client ID,
# redirect URI: <APP_URL>/api/admin/auth/google/callback). Optional.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password reset emails through Resend. Without these, `npm run dev` prints
# the link in the terminal and production cannot send reset emails.
RESEND_API_KEY=
EMAIL_FROM="Gia Sư Nhà Mình <no-reply@your-domain>"

# Local development only: shared password shown on /admin/login under
# `npm run dev`. Ignored in production builds.
ADMIN_PASSWORD=
